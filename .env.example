DJANGO_SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

DB_HOST=
DB_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

AUTH_API_BASE_URL=
AUTH_API_EOL_KEY=
# Timeouts (segundos) — só limitam espera quando o CoreSSO NÃO responde
AUTH_API_CONNECT_TIMEOUT_SECONDS=5
# POST /autenticacao: 401 com senha errada volta na hora; timeout = serviço parado
AUTH_API_AUTH_TIMEOUT_SECONDS=10
# GET DadosSigpae (após login OK): pode demorar mais em homolog
AUTH_API_TIMEOUT_SECONDS=60

# codigoCargo oficial SME (SIGPAE/CoreSSO) = DIRETOR DE ESCOLA
# Usado em GET /api/escolas/{eol}/funcionarios/cargos/{codigo} (SME Integração)
# Referência: seed CargoPermitidoModel (migração 0008)
AUTH_API_CODIGO_CARGO_DIRETOR_ESCOLA=3360

# Logs do fluxo de login no stdout (docker logs). Ativo no docker-compose.debug.yml
LOGIN_DEBUG=0

# Expõe CRUD legado em /api/usuarios/ no backend e no Swagger (login sempre ativo)
USUARIOS_CRUD_ENABLED=false