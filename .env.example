# Backend Recreio nas Ferias - variaveis de ambiente
# Copie para .env e ajuste os valores conforme o ambiente.

# ---------------------------------------------------------------------------
# Django / API
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=sua-chave-aqui
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Banco Postgres
# POSTGRES_HOST e o host do Postgres. Para Docker Compose use `db` (nome do
# servico). Para rodar sem Docker, troque por localhost ou o IP do Postgres.
# POSTGRES_PORT e a porta de conexao com o Postgres.
# ---------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=nome_banco
POSTGRES_USER=usuario_banco
POSTGRES_PASSWORD=senha_banco

# ---------------------------------------------------------------------------
# Portas locais expostas pelo docker-compose
# ---------------------------------------------------------------------------
PORT_WEB=8000
PORT_DEBUGPY=5678

# ---------------------------------------------------------------------------
# Gunicorn / runtime web
# ---------------------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# ---------------------------------------------------------------------------
# Testes
# Por padrao o pytest roda em SQLite em memoria. Defina 1 para rodar contra o
# Postgres configurado acima (util para validacoes especificas de banco).
# Testes marcados com @pytest.mark.postgres so rodam quando esta variavel e 1.
# ---------------------------------------------------------------------------
PYTEST_USE_POSTGRES=

# ---------------------------------------------------------------------------
# Estrategia de migracao no startup
# No entrypoint de producao, o padrao e migrar automaticamente.
# Defina RUN_MIGRATIONS=false apenas quando a migracao for executada
# explicitamente por job ou etapa separada na infraestrutura.
# ---------------------------------------------------------------------------
RUN_MIGRATIONS=true

# Modos:
# - strict: falha o boot se migrate falhar
# - best-effort: tenta migrar e sobe mesmo com erro, no estilo do ETL
RUN_MIGRATIONS_MODE=strict
